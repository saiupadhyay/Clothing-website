# ============================================================
# BLACKFITS BACKEND CONFIGURATION
# Copy this file to .env and fill in your credentials
# ============================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- MONGODB ATLAS CONNECTION ---
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
# Example: mongodb+srv://admin:YourPassword123@cluster0.abcde.mongodb.net/blackfits?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here

# --- CLOUDINARY CDN CONFIGURATION ---
# Get these from Cloudinary Dashboard -> Product Environment Settings
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- JWT SECRET FOR CUSTOMER & ADMIN AUTH ---
# Any random secure string
JWT_SECRET=blackfits_super_secret_jwt_key_2026_discipline
JWT_EXPIRE=30d
